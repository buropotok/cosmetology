+import type {Platform,PublicationResult} from '../../shared/contracts';import {AppError,type Env} from './types';import {validatePublish} from './validation';import {detail,findOrCreate,finish,history,list,pending,publication} from './services/posts';import {getImage,storeImage} from './services/images';import {publishVK} from './services/vk';import {publishTelegram} from './services/telegram';
+const json=(body:unknown,status=200,headers:HeadersInit={})=>new Response(JSON.stringify(body),{status,headers:{'content-type':'application/json; charset=utf-8',...headers}});
+function cors(req:Request,env:Env){const origin=req.headers.get('origin');return origin&&origin===env.ALLOWED_EXTENSION_ORIGIN?{'access-control-allow-origin':origin,'access-control-allow-headers':'authorization, content-type','access-control-allow-methods':'GET, POST, OPTIONS','vary':'Origin'}:{}}
+function authorized(req:Request,env:Env){const supplied=req.headers.get('authorization')?.replace(/^Bearer\s+/,'')??'';return !!env.PUBLISH_API_TOKEN&&supplied===env.PUBLISH_API_TOKEN}
+async function route(req:Request,env:Env){const u=new URL(req.url),headers=cors(req,env);if(req.method==='OPTIONS')return Object.keys(headers).length?new Response(null,{status:204,headers}):new Response(null,{status:403});
+ if(req.method==='GET'&&u.pathname==='/history.txt')return new Response(await history(env),{headers:{'content-type':'text/plain; charset=utf-8','cache-control':'public, max-age=60'}});
+ if(req.method==='GET'&&u.pathname==='/api/posts')return json(await list(env,u,u.origin),200,headers);
+ const postMatch=u.pathname.match(/^\/api\/posts\/(\d+)$/);if(req.method==='GET'&&postMatch){const p=await detail(env,Number(postMatch[1]),u.origin);return p?json(p,200,headers):json({error:{code:'NOT_FOUND',message:'Публикация не найдена'}},404,headers)}
+ const imageMatch=u.pathname.match(/^\/api\/images\/(.+)$/);if(req.method==='GET'&&imageMatch){const object=await getImage(env,decodeURIComponent(imageMatch[1]));if(!object)return new Response('Not found',{status:404});const h=new Headers();object.writeHttpMetadata(h);h.set('etag',object.httpEtag);h.set('cache-control','public, max-age=86400');return new Response(object.body,{headers:h})}
+ if(req.method==='POST'&&u.pathname==='/api/publish'){if(!authorized(req,env))throw new AppError('UNAUTHORIZED','Неверный personal API token',401);const form=await req.formData();const raw=form.get('payload');if(typeof raw!=='string')throw new AppError('INVALID_REQUEST','Поле payload обязательно',400);let parsed:unknown;try{parsed=JSON.parse(raw)}catch{throw new AppError('INVALID_JSON','Некорректный JSON payload',400)}const input=validatePublish(parsed);const file=form.get('image');if(file!==null&&!(file instanceof File))throw new AppError('INVALID_IMAGE','Некорректное изображение',400);
