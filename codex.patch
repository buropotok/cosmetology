@@ -0,0 +1,2 @@
+import type {PublishRequest,Platform} from '../../shared/contracts';import {AppError} from './types';
+export function validatePublish(value:unknown):PublishRequest{if(!value||typeof value!=='object')throw new AppError('INVALID_REQUEST','Некорректное тело запроса',400);const v=value as any;if(typeof v.text!=='string'||!v.text.trim()||v.text.length>100000)throw new AppError('INVALID_TEXT','Текст обязателен и должен быть короче 100 000 символов',400);if(!Array.isArray(v.targets)||v.targets.length<1||v.targets.some((x:unknown)=>x!=='vk'&&x!=='telegram'))throw new AppError('INVALID_TARGETS','Выберите VK и/или Telegram',400);if(typeof v.idempotency_key!=='string'||v.idempotency_key.length<8||v.idempotency_key.length>100)throw new AppError('INVALID_IDEMPOTENCY_KEY','Некорректный идентификатор запроса',400);return {...v,text:v.text.trim(),targets:[...new Set(v.targets as Platform[])]}}
