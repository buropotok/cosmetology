+export interface Preset { id:string; title:string; icon:string; prompt:string; history:boolean }
+const discovery = 'Сначала предложи ровно 5 кратких пронумерованных тем (1–5), а не полные посты. После моего выбора подготовь достоверный пост для VK и Telegram на русском языке.';
+export const presets:Preset[]=[
+ {id:'news',title:'Новости',icon:'📰',history:true,prompt:`Найди актуальные новости доказательной косметологии. ${discovery}`},
+ {id:'myths',title:'Мифы',icon:'💭',history:true,prompt:`Предложи мифы о косметологии, которые полезно корректно разобрать. ${discovery}`},
+ {id:'facts',title:'Интересные факты',icon:'✨',history:true,prompt:`Предложи неожиданные, проверяемые факты о коже и косметологии. ${discovery}`},
+ {id:'science',title:'Научпоп',icon:'🔬',history:true,prompt:`Предложи научно-популярные темы о коже и косметологических процедурах. ${discovery}`},
