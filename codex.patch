+import {ChatGPTAdapter} from './chatgpt-adapter';import {hasFiveChoices,parseResponse} from './response-parser';import {choicePrompt,presets,renderPreset,rewrites} from '../presets/presets';
+const adapter=new ChatGPTAdapter();
+function button(label:string,fn:()=>void){const b=document.createElement('button');b.textContent=label;b.onclick=e=>{e.preventDefault();e.stopPropagation();void Promise.resolve(fn()).catch(console.warn)};return b}
+export async function installToolbar(){if(document.querySelector('[data-social-publisher="toolbar"]'))return;const bar=document.createElement('div');bar.dataset.socialPublisher='toolbar';bar.className='sp-toolbar';const {workerBaseUrl=''}=await chrome.storage.local.get('workerBaseUrl');presets.forEach(p=>bar.append(button(`${p.icon} ${p.title}`,()=>adapter.insert(renderPreset(p,workerBaseUrl)))));document.body.append(bar)}
+export function decorate(){for(const message of adapter.findMessages()){if(message.querySelector('[data-social-publisher="controls"]'))continue;try{const root=adapter.contentRoot(message),text=parseResponse(root);if(!text)continue;const controls=document.createElement('div');controls.dataset.socialPublisher='controls';controls.className='sp-controls';if(hasFiveChoices(text))for(let n=1;n<=5;n++)controls.append(button(String(n),()=>adapter.insert(choicePrompt(n),true)));else rewrites.forEach(([l,p])=>controls.append(button(l,()=>adapter.insert(p,true))));controls.append(button('Опубликовать',async()=>{await chrome.storage.session.set({draft:{text,images:adapter.images(message)}});chrome.runtime.sendMessage({type:'OPEN_PANEL'})}));message.append(controls)}catch(e){console.debug('Social Publisher: message skipped',e)}}}
+export function observe(){adapter.observe(()=>{decorate();void installToolbar()})}
