@@ -0,0 +1,4 @@
+import type {Env} from '../types';import {AppError} from '../types';
+const API='https://api.vk.com/method/',VERSION='5.199';
+async function vk<T>(env:Env,method:string,params:Record<string,string>){const body=new URLSearchParams({...params,access_token:env.VK_ACCESS_TOKEN,v:VERSION});const r=await fetch(API+method,{method:'POST',body});const j=await r.json<any>();if(!r.ok||j.error){console.error('VK API error',j.error?.error_code);throw new AppError('VK_ERROR',`VK отклонил запрос${j.error?.error_code?` (код ${j.error.error_code})`:''}`,502)}return j.response as T}
+export async function publishVK(env:Env,text:string,image?:File){let attachments:string|undefined;if(image){const server=await vk<{upload_url:string}>(env,'photos.getWallUploadServer',{group_id:env.VK_GROUP_ID});const f=new FormData();f.set('photo',image,'image');const uploaded=await fetch(server.upload_url,{method:'POST',body:f}).then(r=>r.json<any>());const saved=await vk<Array<{id:number;owner_id:number}>>(env,'photos.saveWallPhoto',{group_id:env.VK_GROUP_ID,photo:uploaded.photo,server:String(uploaded.server),hash:uploaded.hash});attachments=`photo${saved[0].owner_id}_${saved[0].id}`}const owner=`-${env.VK_GROUP_ID}`;const id=await vk<number>(env,'wall.post',{owner_id:owner,from_group:'1',message:text,...(attachments?{attachments}:{})});return {external_id:String(id),url:`https://vk.com/wall${owner}_${id}`}}
