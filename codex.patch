@@ -0,0 +1,7 @@
+import type {PublishResponse,PostsResponse,PostSummary,Platform} from '../../../shared/contracts';
+export interface Settings{workerBaseUrl:string;apiToken:string}
+async function settings():Promise<Settings>{const s=await chrome.storage.local.get(['workerBaseUrl','apiToken']);if(!s.workerBaseUrl)throw new Error('Укажите Worker URL в настройках');return {workerBaseUrl:String(s.workerBaseUrl).replace(/\/$/,''),apiToken:String(s.apiToken??'')}}
+async function request<T>(path:string,init?:RequestInit){const s=await settings();const r=await fetch(s.workerBaseUrl+path,{...init,headers:{...(init?.headers??{}),Authorization:`Bearer ${s.apiToken}`}});const body=await r.json().catch(()=>({error:{message:`HTTP ${r.status}`}})) as any;if(!r.ok)throw new Error(body.error?.message??`HTTP ${r.status}`);return body as T}
+export async function publish(input:{text:string;targets:Platform[];metadata:Record<string,string>;postId?:number;image?:Blob;idempotencyKey:string}){const form=new FormData();form.set('payload',JSON.stringify({text:input.text,targets:input.targets,metadata:input.metadata,post_id:input.postId,idempotency_key:input.idempotencyKey}));if(input.image)form.set('image',input.image,'post-image');return request<PublishResponse>('/api/publish',{method:'POST',body:form})}
+export const posts=(search='')=>request<PostsResponse>(`/api/posts?page=1&page_size=30&search=${encodeURIComponent(search)}`);
+export const post=(id:number)=>request<PostSummary>(`/api/posts/${id}`);
