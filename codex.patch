+export function formatHistory(rows:any[]){return `COSMETOLOGY PUBLISHED CONTENT HISTORY\n\nPurpose:\nThis document lists previously published content.\nAvoid proposing topics that substantially duplicate these topics/aspects.\n\n${rows.map(r=>`---\n\nDATE: ${r.date}\nTYPE: ${r.content_type||'unspecified'}\nTOPIC: ${r.topic||'Без темы'}\nSUMMARY:\n${r.summary||'Краткое описание не указано.'}\n`).join('\n')}---\n`}
diff --git a/worker/src/services/telegram.ts b/worker/src/services/telegram.ts
new file mode 100644
