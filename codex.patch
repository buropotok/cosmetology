+$('searchButton').onclick=()=>void loadHistory();$('save').onclick=async()=>{await chrome.storage.local.set({workerBaseUrl:$<HTMLInputElement>('workerUrl').value.trim(),apiToken:$<HTMLInputElement>('apiToken').value});alert('Сохранено')};chrome.storage.local.get(['workerBaseUrl','apiToken']).then(s=>{$<HTMLInputElement>('workerUrl').value=s.workerBaseUrl??'';$<HTMLInputElement>('apiToken').value=s.apiToken??''});void draft();
