+++ b/worker/src/services/telegram.ts
@@ -0,0 +1,4 @@
+import type {Env} from '../types';import {AppError} from '../types';
+async function call(env:Env,method:string,body:FormData){const r=await fetch(`https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/${method}`,{method:'POST',body});const j=await r.json<any>();if(!r.ok||!j.ok){console.error('Telegram API error',j.error_code);throw new AppError('TELEGRAM_ERROR',`Telegram отклонил запрос${j.error_code?` (код ${j.error_code})`:''}`,502)}return j.result}
+function url(chat:string,id:number){return chat.startsWith('@')?`https://t.me/${chat.slice(1)}/${id}`:undefined}
+export async function publishTelegram(env:Env,text:string,image?:File){let first;if(image){const f=new FormData();f.set('chat_id',env.TELEGRAM_CHAT_ID);f.set('photo',image,'image');if(text.length<=1024)f.set('caption',text);first=await call(env,'sendPhoto',f);if(text.length>1024){const t=new FormData();t.set('chat_id',env.TELEGRAM_CHAT_ID);t.set('text',text);await call(env,'sendMessage',t)}}else{if(text.length>4096)throw new AppError('TELEGRAM_TEXT_TOO_LONG','Telegram: текст без изображения не должен превышать 4096 символов',400);const f=new FormData();f.set('chat_id',env.TELEGRAM_CHAT_ID);f.set('text',text);first=await call(env,'sendMessage',f)}return {external_id:String(first.message_id),url:url(env.TELEGRAM_CHAT_ID,first.message_id)}}
