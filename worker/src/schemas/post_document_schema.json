{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["paragraph", "heading", "quote", "details", "bullet_list", "ordered_list"] },
          "content": { "$ref": "#/definitions/runs" },
          "title": { "$ref": "#/definitions/runs" },
          "emoji": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/definitions/listItem" }
          }
        },
        "required": ["type"]
      }
    },
    "buttons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string" },
          "url": { "type": "string" }
        },
        "required": ["text", "url"]
      }
    }
  },
  "required": ["schemaVersion", "blocks"],
  "definitions": {
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["bold", "italic", "underline", "strikethrough", "spoiler", "link"] },
        "href": { "type": "string" }
      },
      "required": ["type"]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "marks": { "type": "array", "items": { "$ref": "#/definitions/mark" } }
      },
      "required": ["text"]
    },
    "runs": {
      "type": "array",
      "items": { "$ref": "#/definitions/run" }
    },
    "nestedListItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": { "$ref": "#/definitions/runs" }
      },
      "required": ["content"]
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": { "$ref": "#/definitions/runs" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/nestedListItem" }
        }
      },
      "required": ["content"]
    }
  }
}
